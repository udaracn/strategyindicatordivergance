//@version=5
strategy("BTC 15m High Success Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, max_lines_count=200, max_labels_count=500)

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ►►► USER INPUTS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// RSI Settings
rsiLength = input.int(14, "RSI Length", minval=1, group="RSI Settings")
rsiSource = input.source(close, "RSI Source", group="RSI Settings")
lbL = input.int(5, "Pivot Lookback Left", group="RSI Settings")
lbR = input.int(5, "Pivot Lookback Right", group="RSI Settings")

// SnR Settings
snrLength = input.int(25, "Bars to Detect A&V Levels", minval=10, group="SnR Settings")
maxALines = input.int(5, "Max Resistance Lines", minval=4, group="SnR Settings")
maxVLines = input.int(5, "Max Support Lines", minval=4, group="SnR Settings")
maxGapLines = input.int(5, "Max Gap Lines", minval=4, group="SnR Settings")
showSnRLines = input.bool(true, "Show SnR Lines", group="SnR Settings")

// Risk Management
tpPerc = input.float(1.5, "Take Profit %", minval=0.1, group="Risk Management") / 100
slPerc = input.float(1.0, "Stop Loss %", minval=0.1, group="Risk Management") / 100
nearThreshold = input.float(0.5, "Near Level Threshold %", minval=0.0, group="Confluence Settings", tooltip="How close price must be to a level to consider it a touch") / 100

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ►►► RSI DIVERGENCE DETECTION
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

rsiValue = ta.rsi(rsiSource, rsiLength)
ph = ta.pivothigh(rsiValue, lbL, lbR)
pl = ta.pivotlow(rsiValue, lbL, lbR)

var float lastPHValue = na
var int lastPHBar = na
var float prevPHValue = na
var int prevPHBar = na

var float lastPLValue = na
var int lastPLBar = na
var float prevPLValue = na
var int prevPLBar = na

if not na(ph)
    prevPHValue := lastPHValue
    prevPHBar := lastPHBar
    lastPHValue := ph
    lastPHBar := bar_index[lbR]

if not na(pl)
    prevPLValue := lastPLValue
    prevPLBar := lastPLBar
    lastPLValue := pl
    lastPLBar := bar_index[lbR]

// Divergence confirmation occurs at current bar when a pivot was confirmed lbR bars ago
regBull = not na(pl) and low[lbR] < low[bar_index - prevPLBar] and lastPLValue > prevPLValue
regBear = not na(ph) and high[lbR] > high[bar_index - prevPHBar] and lastPHValue < prevPHValue
hidBull = not na(pl) and low[lbR] > low[bar_index - prevPLBar] and lastPLValue < prevPLValue
hidBear = not na(ph) and high[lbR] < high[bar_index - prevPHBar] and lastPHValue > prevPHValue

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ►►► CANDLE RANGE THEORY (CRT) LOGIC
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

crtBull = low < low[1] and close > low[1]
crtBear = high > high[1] and close < high[1]

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ►►► MALAYSIAN SNR & GAPS LOGIC
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Alevel = ta.pivothigh(close, snrLength, snrLength)
vlevel = ta.pivotlow(close, snrLength, snrLength)

var line[] resLines = array.new_line()
var bool[] resStates = array.new_bool()
var line[] supLines = array.new_line()
var bool[] supStates = array.new_bool()

var line[] gapLines = array.new_line()
var float[] gapLevels = array.new_float()
var bool[] gapFreshStates = array.new_bool()
var int[] gapCreatedAtBars = array.new_int()
var color[] gapColors = array.new_color()

// Helper Functions
limitLineArraySize(arr, stateArr, maxSize) =>
    while array.size(arr) > maxSize
        if array.size(arr) > 0
            lineToRemove = array.shift(arr)
            if not na(lineToRemove)
                line.delete(lineToRemove)
            array.shift(stateArr)

limitGapArraySize(arr, levelArr, stateArr, createdAtBars, colorArr, maxSize) =>
    while array.size(arr) > maxSize
        if array.size(arr) > 0
            lineToRemove = array.shift(arr)
            if not na(lineToRemove)
                line.delete(lineToRemove)
        if array.size(levelArr) > 0
            array.shift(levelArr)
        if array.size(stateArr) > 0
            array.shift(stateArr)
        if array.size(createdAtBars) > 0
            array.shift(createdAtBars)
        if array.size(colorArr) > 0
            array.shift(colorArr)

// Add SnR Levels
if not na(Alevel) and barstate.isconfirmed
    resBar = bar_index - snrLength
    if resBar >= 0
        resLine = line.new(x1=resBar, y1=Alevel, x2=bar_index, y2=Alevel, color=color.new(color.red, showSnRLines ? 0 : 100), width=1, style=line.style_solid, extend=extend.right)
        array.push(resLines, resLine)
        array.push(resStates, true)
        limitLineArraySize(resLines, resStates, maxALines)

if not na(vlevel) and barstate.isconfirmed
    supBar = bar_index - snrLength
    if supBar >= 0
        supLine = line.new(x1=supBar, y1=vlevel, x2=bar_index, y2=vlevel, color=color.new(color.green, showSnRLines ? 0 : 100), width=1, style=line.style_solid, extend=extend.right)
        array.push(supLines, supLine)
        array.push(supStates, true)
        limitLineArraySize(supLines, supStates, maxVLines)

// Add Gaps
if barstate.isconfirmed and bar_index > 1
    isBullishGap = (close[0] > open[0] and close[1] > open[1])
    isBearishGap = (close[0] < open[0] and close[1] < open[1])
    if isBullishGap
        gapPrice = close[1]
        gapLine = line.new(x1=bar_index-1, y1=gapPrice, x2=bar_index, y2=gapPrice, color=color.new(color.blue, showSnRLines ? 0 : 100), width=1, style=line.style_solid, extend=extend.right)
        array.push(gapLines, gapLine)
        array.push(gapLevels, gapPrice)
        array.push(gapFreshStates, true)
        array.push(gapCreatedAtBars, bar_index-1)
        array.push(gapColors, color.blue)
    if isBearishGap
        gapPrice = close[1]
        gapLine = line.new(x1=bar_index-1, y1=gapPrice, x2=bar_index, y2=gapPrice, color=color.new(#b121f3, showSnRLines ? 0 : 100), width=1, style=line.style_solid, extend=extend.right)
        array.push(gapLines, gapLine)
        array.push(gapLevels, gapPrice)
        array.push(gapFreshStates, true)
        array.push(gapCreatedAtBars, bar_index-1)
        array.push(gapColors, #b121f3)
    limitGapArraySize(gapLines, gapLevels, gapFreshStates, gapCreatedAtBars, gapColors, maxGapLines)

// Update Freshness and Styles
if array.size(resLines) > 0
    for i = 0 to array.size(resLines) - 1
        ln = array.get(resLines, i)
        lp = line.get_y1(ln)
        st = array.get(resStates, i)
        wickTouched = (high >= lp and low <= lp)
        bodyCrossed = (math.min(open, close) < lp and math.max(open, close) > lp)
        if bodyCrossed
            array.set(resStates, i, true)
        else if wickTouched and st
            array.set(resStates, i, false)
        line.set_style(ln, array.get(resStates, i) ? line.style_solid : line.style_dashed)

if array.size(supLines) > 0
    for i = 0 to array.size(supLines) - 1
        ln = array.get(supLines, i)
        lp = line.get_y1(ln)
        st = array.get(supStates, i)
        wickTouched = (high >= lp and low <= lp)
        bodyCrossed = (math.min(open, close) < lp and math.max(open, close) > lp)
        if bodyCrossed
            array.set(supStates, i, true)
        else if wickTouched and st
            array.set(supStates, i, false)
        line.set_style(ln, array.get(supStates, i) ? line.style_solid : line.style_dashed)

if array.size(gapLines) > 0
    for i = 0 to array.size(gapLines) - 1
        lp = array.get(gapLevels, i)
        st = array.get(gapFreshStates, i)
        ln = array.get(gapLines, i)
        if bar_index > array.get(gapCreatedAtBars, i)
            wickTouched = (high >= lp and low <= lp)
            bodyCrossed = (math.min(open, close) < lp and math.max(open, close) > lp)
            if bodyCrossed
                array.set(gapFreshStates, i, true)
            else if wickTouched and st
                array.set(gapFreshStates, i, false)
            line.set_style(ln, array.get(gapFreshStates, i) ? line.style_solid : line.style_dashed)

// Confluence Detection Functions
isNearSupport() =>
    near = false
    if array.size(supLines) > 0
        for i = 0 to array.size(supLines) - 1
            if array.get(supStates, i) and math.abs(close - line.get_y1(array.get(supLines, i))) <= close * nearThreshold
                near := true
                break
    if not near and array.size(gapLevels) > 0
        for i = 0 to array.size(gapLevels) - 1
            if array.get(gapFreshStates, i) and array.get(gapColors, i) == color.blue and math.abs(close - array.get(gapLevels, i)) <= close * nearThreshold
                near := true
                break
    near

isNearResistance() =>
    near = false
    if array.size(resLines) > 0
        for i = 0 to array.size(resLines) - 1
            if array.get(resStates, i) and math.abs(close - line.get_y1(array.get(resLines, i))) <= close * nearThreshold
                near := true
                break
    if not near and array.size(gapLevels) > 0
        for i = 0 to array.size(gapLevels) - 1
            if array.get(gapFreshStates, i) and array.get(gapColors, i) == #b121f3 and math.abs(close - array.get(gapLevels, i)) <= close * nearThreshold
                near := true
                break
    near

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ►►► STRATEGY EXECUTION
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Confluence: Divergence (confirmed at lbR bars ago) + CRT Sweep (now) + Near Level (now)
hasBullDivergence = regBull or hidBull
hasBearDivergence = regBear or hidBear

longCondition = hasBullDivergence and crtBull and isNearSupport()
shortCondition = hasBearDivergence and crtBear and isNearResistance()

var float entryPrice = na
var float tpPrice = na
var float slPrice = na

if longCondition and strategy.position_size == 0
    entryPrice := close
    tpPrice := entryPrice * (1 + tpPerc)
    slPrice := entryPrice * (1 - slPerc)
    strategy.entry("Long", strategy.long)
    label.new(bar_index, high, "Long Entry\nPrice: " + str.tostring(entryPrice, "#.##") + "\nTP: " + str.tostring(tpPrice, "#.##") + "\nSL: " + str.tostring(slPrice, "#.##"), color=color.green, textcolor=color.white, style=label.style_label_down)

if shortCondition and strategy.position_size == 0
    entryPrice := close
    tpPrice := entryPrice * (1 - tpPerc)
    slPrice := entryPrice * (1 + slPerc)
    strategy.entry("Short", strategy.short)
    label.new(bar_index, low, "Short Entry\nPrice: " + str.tostring(entryPrice, "#.##") + "\nTP: " + str.tostring(tpPrice, "#.##") + "\nSL: " + str.tostring(slPrice, "#.##"), color=color.red, textcolor=color.white, style=label.style_label_up)

if strategy.position_size > 0
    strategy.exit("Exit Long", "Long", limit=tpPrice, stop=slPrice)
if strategy.position_size < 0
    strategy.exit("Exit Short", "Short", limit=tpPrice, stop=slPrice)

// Visuals for Debugging/Confirmation
plotshape(hasBullDivergence, "Bull Div confirmed", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(hasBearDivergence, "Bear Div confirmed", shape.triangledown, location.abovebar, color.maroon, size=size.small)
plotshape(crtBull, "CRT Bull", shape.circle, location.belowbar, color.blue, size=size.tiny)
plotshape(crtBear, "CRT Bear", shape.circle, location.abovebar, color.orange, size=size.tiny)
